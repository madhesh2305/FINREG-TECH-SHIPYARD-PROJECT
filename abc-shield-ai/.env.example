# ==============================================================================
# ABC Shield AI / FinRegTech ShipYard - Environment Configuration Template
# Copy this file to .env and provide your local credentials.
# ==============================================================================

# Application Environment
ENVIRONMENT=development
LOG_LEVEL=INFO

# Storage & Vector Database Paths
DATA_RAW_DIR=./data/raw
DATA_PROCESSED_DIR=./data/processed
CHROMA_PERSIST_DIR=./data/processed/chroma_db
CHROMA_COLLECTION_NAME=regulatory_records

# Embedding Configuration
# Default is a lightweight local sentence-transformers model to enable zero-cost local execution
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2

# LLM Provider Configuration
LLM_PROVIDER=openai
LLM_API_KEY=your_api_key_here
LLM_MODEL_NAME=gpt-4o-mini
LLM_BASE_URL=
LLM_TEMPERATURE=0.0

# Retrieval & Guardrail Thresholds
RETRIEVAL_TOP_K=5
MIN_SIMILARITY_SCORE=0.50
REQUIRE_APPROVED_STATUS_ONLY=true

# API Server Configuration
API_HOST=0.0.0.0
API_PORT=8001
