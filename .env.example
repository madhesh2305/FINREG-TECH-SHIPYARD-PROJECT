# FinRegTech Shipyard - Environment Configuration Example
PROJECT_NAME="FinRegTech Shipyard - FCC Project Cockpit"
API_V1_STR="/api/v1"
ENVIRONMENT="development"
PORT=8000
HOST="127.0.0.1"

# Database Configuration (Dedicated finreg_app local user)
DATABASE_URL="postgresql://finreg_app:finreg_secure_pass@localhost:5432/FinRegTech ShipYard"
# Fallback SQLite DB URL for offline local development if PostgreSQL is unavailable
SQLITE_FALLBACK_URL="sqlite:///./finregtech_dev.db"

# JWT Security
SECRET_KEY="finregtech-shipyard-secret-key-change-in-production-min-32-bytes"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=480

# CORS Configuration (Next.js / Vite development origins)
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","http://127.0.0.1:5173","http://127.0.0.1:3000"]
